{
  "name": "@functional-systems/lambdadb",
  "version": "0.4.3",
  "author": "Functional Systems, Inc.",
  "homepage": "https://github.com/lambdadb/lambdadb-typescript-client#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/lambdadb-typescript-client.git"
  },
  "type": "module",
  "files": [
    "dist/",
    "src/",
    "FUNCTIONS.md",
    "RUNTIMES.md",
    "USAGE.md",
    "jsr.json"
  ],
  "tshy": {
    "sourceDialects": [
      "@functional-systems/lambdadb/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models/errors": "./src/models/errors/index.ts",
      "./models": "./src/models/index.ts",
      "./models/operations": "./src/models/operations/index.ts",
      "./compat/qdrant": "./src/compat/qdrant.ts",
      "./compat/qdrant/models": "./src/compat/qdrant/models.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --cache --max-warnings=0 src",
    "build": "tshy",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:external:qdrant": "npm run build && LAMBDADB_RUN_EXTERNAL_INTEGRATION_TESTS=1 node --test test/integration/qdrant-compat-external.test.mjs",
    "test:live:qdrant": "npm run build && node --env-file-if-exists=.env --test test/integration/qdrant-compat-live.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@langchain/core": "1.1.47",
    "@langchain/qdrant": "1.0.3",
    "@llamaindex/core": "0.6.23",
    "@llamaindex/env": "0.1.31",
    "@llamaindex/qdrant": "0.1.33",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "tshy": "^2.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/index.ts",
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./types": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/types/index.ts",
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/types/index.js"
      },
      "require": {
        "types": "./dist/commonjs/types/index.d.ts",
        "default": "./dist/commonjs/types/index.js"
      }
    },
    "./models/errors": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/models/errors/index.ts",
        "types": "./dist/esm/models/errors/index.d.ts",
        "default": "./dist/esm/models/errors/index.js"
      },
      "require": {
        "types": "./dist/commonjs/models/errors/index.d.ts",
        "default": "./dist/commonjs/models/errors/index.js"
      }
    },
    "./models": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/models/index.ts",
        "types": "./dist/esm/models/index.d.ts",
        "default": "./dist/esm/models/index.js"
      },
      "require": {
        "types": "./dist/commonjs/models/index.d.ts",
        "default": "./dist/commonjs/models/index.js"
      }
    },
    "./models/operations": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/models/operations/index.ts",
        "types": "./dist/esm/models/operations/index.d.ts",
        "default": "./dist/esm/models/operations/index.js"
      },
      "require": {
        "types": "./dist/commonjs/models/operations/index.d.ts",
        "default": "./dist/commonjs/models/operations/index.js"
      }
    },
    "./compat/qdrant": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/compat/qdrant.ts",
        "types": "./dist/esm/compat/qdrant.d.ts",
        "default": "./dist/esm/compat/qdrant.js"
      },
      "require": {
        "types": "./dist/commonjs/compat/qdrant.d.ts",
        "default": "./dist/commonjs/compat/qdrant.js"
      }
    },
    "./compat/qdrant/models": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/compat/qdrant/models.ts",
        "types": "./dist/esm/compat/qdrant/models.d.ts",
        "default": "./dist/esm/compat/qdrant/models.js"
      },
      "require": {
        "types": "./dist/commonjs/compat/qdrant/models.d.ts",
        "default": "./dist/commonjs/compat/qdrant/models.js"
      }
    },
    "./*.js": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/*.ts",
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/commonjs/*.d.ts",
        "default": "./dist/commonjs/*.js"
      }
    },
    "./*": {
      "import": {
        "@functional-systems/lambdadb/source": "./src/*.ts",
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/commonjs/*.d.ts",
        "default": "./dist/commonjs/*.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
